def length_converter():
    print("\nLength Converter:")
    print("1. Meters to Kilometers")
    print("2. Kilometers to Meters")
    print("3. Inches to Centimeters")
    print("4. Centimeters to Inches")
    choice = input("Choose an option: ")

    value = float(input("Enter value to convert: "))

    if choice == '1':
        print(f"{value} meters = {value / 1000} kilometers")
    elif choice == '2':
        print(f"{value} kilometers = {value * 1000} meters")
    elif choice == '3':
        print(f"{value} inches = {value * 2.54} centimeters")
    elif choice == '4':
        print(f"{value} centimeters = {value / 2.54} inches")
    else:
        print("Invalid option.")


def weight_converter():
    print("\nWeight Converter:")
    print("1. Kilograms to Pounds")
    print("2. Pounds to Kilograms")
    choice = input("Choose an option: ")

    value = float(input("Enter value to convert: "))

    if choice == '1':
        print(f"{value} kg = {value * 2.20462} lbs")
    elif choice == '2':
        print(f"{value} lbs = {value / 2.20462} kg")
    else:
        print("Invalid option.")


def temperature_converter():
    print("\nTemperature Converter:")
    print("1. Celsius to Fahrenheit")
    print("2. Fahrenheit to Celsius")
    choice = input("Choose an option: ")

    value = float(input("Enter value to convert: "))

    if choice == '1':
        print(f"{value}°C = {(value * 9/5) + 32}°F")
    elif choice == '2':
        print(f"{value}°F = {(value - 32) * 5/9}°C")
    else:
        print("Invalid option.")


def main():
    while True:
        print("\n--- Unit Converter ---")
        print("1. Length")
        print("2. Weight")
        print("3. Temperature")
        print("4. Exit")
        option = input("Choose a category: ")

        if option == '1':
            length_converter()
        elif option == '2':
            weight_converter()
        elif option == '3':
            temperature_converter()
        elif option == '4':
            print("Exiting Unit Converter. Goodbye!")
            break
        else:
            print("Invalid choice. Try again.")

if __name__ == "__main__":
    main()
