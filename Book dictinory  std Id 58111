# Initialize an empty book dictionary
books = {}

def add_book():
    bookid = input("Enter Book Id (unique ID): ")
    if bookid in books:
        print("Book with this Book Id already exists!")
        return
    title = input("Enter Book Title: ")
    author = input("Enter Author Name: ")
    year = input("Enter Year Published: ")
    books[bookid] = {"title": title, "author": author, "year": year}
    print("Book added successfully!\n")

def update_book():
    bookid = input("Enter Book Id of the book to update: ")
    if bookid in books:
        title = input("Enter New Title: ")
        author = input("Enter New Author: ")
        year = input("Enter New Year: ")
        books[bookid] = {"title": title, "author": author, "year": year}
        print("Book updated successfully!\n")
    else:
        print("Book not found!\n")

def delete_book():
    bookid = input("Enter Book Id of the book to delete: ")
    if bookid in books:
        del books[bookid]
        print("Book deleted successfully!\n")
    else:
        print("Book not found!\n")

def display_books():
    if not books:
        print("No books in the library.\n")
        return
    print("\n--- Book List ---")
    for bookid, info in books.items():
        print(f"ISBN: {bookid}")
        print(f" Title: {info['title']}")
        print(f" Author: {info['author']}")
        print(f" Year: {info['year']}\n")

def main():
    while True:
        print("===== Book Dictionary Menu =====")
        print("1. Add Book")
        print("2. Update Book")
        print("3. Delete Book")
        print("4. Display All Books")
        print("5. Exit")
        choice = input("Enter your choice (1-5): ")

        if choice == '1':
            add_book()
        elif choice == '2':
            update_book()
        elif choice == '3':
            delete_book()
        elif choice == '4':
            display_books()
        elif choice == '5':
            print("Exiting program. Goodbye!")
            break
        else:
            print("Invalid choice. Try again.\n")

if __name__ == "__main__":
    main()
